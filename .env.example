# ==============================================================================
# PLANTILLA DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y ajusta los valores para tu entorno.
# ==============================================================================

# --- PUERTOS EXPUESTOS EN EL HOST ---
ODOO_PORT=8069
POSTGRES_PORT=5434
REDIS_PORT=6379
MQTT_PORT=1883
MQTT_WS_PORT=9001
GPS_BROKER_PORT=8088

# --- BASE DE DATOS (POSTGRESQL 15 + POSTGIS 3.4) ---
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_password
ODOO_DB_NAME=flota_db

# --- CONFIGURACIÓN MAESTRA DE ODOO ---
ODOO_ADMIN_PASSWORD=admin_master_secret

# --- BROKER GPS Y TELEMETRÍA (FASTAPI + POSTGIS) ---
ODOO_URL=http://web:8069
ODOO_API_TOKEN=GPS_SECRET_KEY_2026
DEVICE_API_TOKEN=GPS_DEVICE_SECRET_2026

# Conexión Redis
REDIS_URL=redis://redis:6379/0

# Conexión DB directa para Broker GPS
PG_HOST=db
PG_PORT=5432
PG_DB=flota_db
PG_USER=odoo
PG_PASS=odoo_password

# Mosquitto MQTT
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=gps_device
MQTT_PASSWORD=GPS_DEVICE_SECRET_2026

# Parámetros Operativos y Cartografía
CARTO_API_KEY=cb1_3skd_1_b01311b843bcb7fb316c4384
SPEED_LIMIT_KMH=70.0
MAX_DEVIATION_METERS=400.0

# --- SINCRONIZACIÓN VICEMINISTERIO DE TRANSPORTE (VMT PARAGUAY) ---
VMT_DB_HOST=monitoreo.vmt.gov.py
VMT_DB_PORT=5432
VMT_DB_NAME=bbdd-monitoreo-prod
VMT_DB_USER=jefe-CID
VMT_DB_PASS=vmtdmt
VMT_AGENCY_ID=004B
