<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_transit">
        <field name="name">Operaciones de Transporte</field>
        <field name="description">Gestión de despachos, rutas, horarios y control de flota de buses</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_transit_user" model="res.groups">
        <field name="name">Operador / Despachador</field>
        <field name="category_id" ref="module_category_transit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Acceso a registro de despachos, control de salidas y emisión de boletos.</field>
    </record>

    <record id="group_transit_manager" model="res.groups">
        <field name="name">Jefe de Tráfico / Administrador</field>
        <field name="category_id" ref="module_category_transit"/>
        <field name="implied_ids" eval="[(4, ref('group_transit_user')), (4, ref('fleet.fleet_group_manager'))]"/>
        <field name="comment">Control total sobre configuración de rutas, horarios, asignaciones y facturación electrónica.</field>
    </record>
</odoo>
