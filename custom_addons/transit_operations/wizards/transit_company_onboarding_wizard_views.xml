<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transit_company_onboarding_wizard_form" model="ir.ui.view">
        <field name="name">transit.company.onboarding.wizard.form</field>
        <field name="model">transit.company.onboarding.wizard</field>
        <field name="arch" type="xml">
            <form string="Alta de Nueva Empresa de Transporte (Multi-Tenant)">
                <p class="text-muted">
                    Este asistente crea una nueva empresa operadora de transporte y su usuario administrador inicial (Jefe de Tráfico) de forma 100% aislada.
                </p>
                <group>
                    <group string="1. Datos de la Empresa Concesionaria">
                        <field name="company_name"/>
                        <field name="agency_id"/>
                        <field name="code"/>
                        <field name="legal_name"/>
                        <field name="vat_ruc"/>
                    </group>
                    <group string="2. Contacto y Base Operativa">
                        <field name="contact_phone"/>
                        <field name="contact_email"/>
                        <field name="address"/>
                    </group>
                </group>
                <group string="3. Usuario Administrador de la Empresa (Jefe de Tráfico)">
                    <group>
                        <field name="admin_name"/>
                        <field name="admin_login"/>
                        <field name="admin_password" password="True"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_company" string="Crear Empresa y Usuario" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_transit_company_onboarding_wizard" model="ir.actions.act_window">
        <field name="name">Alta Rápida de Empresa de Transporte</field>
        <field name="res_model">transit.company.onboarding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('group_transit_manager'))]"/>
    </record>
</odoo>
