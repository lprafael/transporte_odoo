<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Formulario del Wizard de Cambio de Contraseña -->
    <record id="view_transit_user_password_wizard_form" model="ir.ui.view">
        <field name="name">transit.user.password.wizard.form</field>
        <field name="model">transit.user.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Restablecer Contraseña de Operador">
                <field name="user_id" invisible="1"/>
                <group>
                    <group string="Operador">
                        <field name="user_name"/>
                        <field name="user_login"/>
                        <field name="concessionaire_id"/>
                    </group>
                    <group string="Nueva Clave de Acceso">
                        <field name="new_password" password="True"/>
                    </group>
                </group>
                <footer>
                    <button name="action_reset_password"
                            string="Guardar Nueva Contraseña"
                            type="object"
                            class="btn-primary"
                            icon="fa-key"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana para el Wizard de Contraseña -->
    <record id="action_transit_user_password_wizard" model="ir.actions.act_window">
        <field name="name">Restablecer Contraseña de Operador</field>
        <field name="res_model">transit.user.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('group_transit_company_manager')), (4, ref('group_transit_manager'))]"/>
    </record>
</odoo>
