<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transit_simulation_wizard_form" model="ir.ui.view">
        <field name="name">transit.simulation.wizard.form</field>
        <field name="model">transit.simulation.wizard</field>
        <field name="arch" type="xml">
            <form string="Simulador de Operación y Cobertura de Flota Actual">
                <sheet>
                    <div class="alert alert-info mb-3" role="alert">
                        <strong>⚡ Simulador de Operación y Cobertura de Red (Multi-Servicio):</strong>
                        Evalúe en tiempo real la capacidad de cobertura que su flota actual (eléctrica y convencional) tiene para cumplir al 100% los cuadros de marcha, frecuencias e intervalos requeridos en los servicios de la empresa.
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Escenario de Simulación"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="1. Configuración de Operadora y Servicios">
                            <field name="concessionaire_id"/>
                            <field name="service_ids" widget="many2many_tags" placeholder="Seleccione servicios a simular (ej: E1, E2, E3)..."/>
                            <field name="simulation_day_type"/>
                        </group>
                        <group string="2. Flota Actual Disponible (Censo / What-If)">
                            <field name="total_fleet_available" style="font-weight:bold;"/>
                            <field name="electric_fleet_available"/>
                            <field name="conventional_fleet_available"/>
                            <field name="depot_chargers_available"/>
                        </group>
                    </group>

                    <group>
                        <group string="3. Parámetros de Tráfico y Regulación">
                            <field name="commercial_speed_kmh"/>
                            <field name="headway_buffer_pct"/>
                            <field name="reserve_fleet_pct"/>
                        </group>
                        <group string="4. Parámetros de Batería y Autonomía EV">
                            <field name="battery_usable_kwh"/>
                            <field name="avg_ev_consumption_kwh_km"/>
                            <field name="min_departure_soc_pct"/>
                        </group>
                    </group>

                    <div class="text-center my-3">
                        <button name="action_calculate_simulation" string="🔄 Calcular Simulación de Cobertura" type="object" class="btn-primary btn-lg shadow-sm"/>
                    </div>

                    <!-- Panel de Resultados de Cobertura -->
                    <div class="mt-4 p-3 bg-light border rounded" invisible="not line_ids">
                        <h4 class="text-primary mb-3">📊 Indicadores Consolidados de Cobertura y Factibilidad</h4>
                        <div class="row text-center mb-3">
                            <div class="col-md-3 border-end">
                                <small class="text-muted text-uppercase fw-bold">Porcentaje de Cobertura</small>
                                <h1 class="mt-1 mb-0" style="color: #059669;"><field name="coverage_percentage"/>%</h1>
                                <small><field name="coverage_status"/></small>
                            </div>
                            <div class="col-md-3 border-end">
                                <small class="text-muted text-uppercase fw-bold">Balance de Flota</small>
                                <h2 class="mt-1 mb-0"><field name="fleet_balance"/> buses</h2>
                                <small class="text-muted"><field name="total_fleet_available"/> disponibles vs <field name="total_fleet_needed"/> requeridos</small>
                            </div>
                            <div class="col-md-3 border-end">
                                <small class="text-muted text-uppercase fw-bold">Intervalo Factible en Pico</small>
                                <h2 class="text-primary mt-1 mb-0"><field name="achievable_peak_headway_minutes"/> min</h2>
                                <small class="text-muted">Garantizado con flota actual</small>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted text-uppercase fw-bold">Factibilidad Energética EV</small>
                                <h3 class="mt-1 mb-0"><field name="energy_feasibility"/></h3>
                                <small class="text-muted"><field name="avg_km_per_bus"/> km/bus diario</small>
                            </div>
                        </div>

                        <notebook>
                            <page string="Desglose por Servicio" name="lines">
                                <field name="line_ids" readonly="1">
                                    <list>
                                        <field name="service_code" decoration-bf="1"/>
                                        <field name="service_name"/>
                                        <field name="cycle_distance_km" string="Km Ciclo"/>
                                        <field name="cycle_time_minutes" string="Tiempo Ciclo (min)"/>
                                        <field name="peak_headway_minutes" string="Headway Pico (min)"/>
                                        <field name="scheduled_departures" string="Salidas/Día"/>
                                        <field name="peak_buses_needed" string="Buses Pico"/>
                                        <field name="reserve_buses_needed" string="Reserva"/>
                                        <field name="total_buses_needed" string="Total Necesario" decoration-bf="1"/>
                                        <field name="daily_commercial_km" string="Km Totales"/>
                                    </list>
                                </field>
                                <group col="4">
                                    <field name="total_peak_buses_needed"/>
                                    <field name="total_reserve_buses_needed"/>
                                    <field name="total_daily_trips"/>
                                    <field name="total_daily_km"/>
                                    <field name="total_daily_energy_kwh"/>
                                </group>
                            </page>

                            <page string="Dictamen y Recomendaciones de Tráfico" name="recommendations">
                                <field name="recommendation_notes" widget="text" readonly="1" style="font-family: monospace; font-size: 13px; line-height: 1.6;"/>
                            </page>
                        </notebook>
                    </div>

                    <footer>
                        <button string="Cerrar Simulador" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transit_simulation_wizard" model="ir.actions.act_window">
        <field name="name">Simulador de Operación y Cobertura de Flota</field>
        <field name="res_model">transit.simulation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
