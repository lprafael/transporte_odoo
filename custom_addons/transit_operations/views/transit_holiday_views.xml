<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista de Feriados -->
    <record id="view_transit_holiday_tree" model="ir.ui.view">
        <field name="name">transit.holiday.list</field>
        <field name="model">transit.holiday</field>
        <field name="arch" type="xml">
            <list string="Feriados Oficiales y Régimen Operativo">
                <field name="date"/>
                <field name="name"/>
                <field name="is_national" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario de Feriado -->
    <record id="view_transit_holiday_form" model="ir.ui.view">
        <field name="name">transit.holiday.form</field>
        <field name="model">transit.holiday</field>
        <field name="arch" type="xml">
            <form string="Feriado Oficial">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Denominación del Feriado"/>
                        <h1>
                            <field name="name" placeholder="Ej: Fundación de Asunción, Independencia Nacional..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="is_national"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Notas / Decreto Reglamentario">
                        <field name="notes" placeholder="Número de ley o decreto oficial que establece el feriado..."/>
                    </group>
                    <div class="alert alert-info mt-3" role="alert">
                        <strong>📌 Régimen Operativo:</strong> En los días declarados como feriados oficiales, el sistema aplica automáticamente la programación operativa de <strong>Domingos y Feriados (Tipo de Día 7)</strong> según la normativa del Viceministerio de Transporte (GVMT).
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana para Feriados -->
    <record id="action_transit_holiday" model="ir.actions.act_window">
        <field name="name">Calendario Oficial de Feriados</field>
        <field name="res_model">transit.holiday</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registre los feriados oficiales para el cálculo automático de los regímenes operativos (L-V vs Fin de Semana/Feriados).
            </p>
        </field>
    </record>
</odoo>
