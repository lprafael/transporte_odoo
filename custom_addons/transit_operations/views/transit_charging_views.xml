<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Patio de Carga: Lista -->
    <record id="view_transit_charging_station_list" model="ir.ui.view">
        <field name="name">transit.charging.station.list</field>
        <field name="model">transit.charging.station</field>
        <field name="arch" type="xml">
            <list string="Patios y Estaciones de Carga Eléctrica">
                <field name="code"/>
                <field name="name"/>
                <field name="concessionaire_id"/>
                <field name="contracted_power_kw" string="Potencia Contratada (kW)"/>
                <field name="current_power_draw_kw" string="Demanda Instantánea (kW)"/>
                <field name="power_utilization_rate" string="% Utilización Acometida" widget="progressbar"/>
                <field name="charger_count" string="Cargadores"/>
                <field name="active_charging_count" string="En Carga"/>
                <field name="peak_shaving_active" widget="boolean" string="Peak-Shaving"/>
            </list>
        </field>
    </record>

    <!-- Patio de Carga: Formulario -->
    <record id="view_transit_charging_station_form" model="ir.ui.view">
        <field name="name">transit.charging.station.form</field>
        <field name="model">transit.charging.station</field>
        <field name="arch" type="xml">
            <form string="Estación de Recarga Eléctrica">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nombre del Patio / Cochera"/>
                        <h1><field name="name" placeholder="Ej: Patio Central Línea 20 - San Lorenzo"/></h1>
                        <h3><field name="code" placeholder="Código: PAT-SL01"/></h3>
                    </div>
                    <group>
                        <group string="Acometida Eléctrica y Gestión de Potencia">
                            <field name="concessionaire_id"/>
                            <field name="contracted_power_kw"/>
                            <field name="current_power_draw_kw"/>
                            <field name="power_utilization_rate" widget="progressbar"/>
                            <field name="peak_shaving_active" widget="boolean_toggle"/>
                        </group>
                        <group string="Ubicación Geográfica">
                            <field name="address"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Dispensadores de Carga Físicos" name="chargers">
                            <field name="charger_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="ocpp_id"/>
                                    <field name="charger_type"/>
                                    <field name="connector_standard"/>
                                    <field name="max_nominal_power_kw"/>
                                    <field name="current_output_kw"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'available'"
                                           decoration-warning="status == 'charging'"
                                           decoration-danger="status == 'fault'"
                                           decoration-info="status == 'reserved'"/>
                                    <field name="current_vehicle_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Historial de Sesiones de Carga" name="sessions">
                            <field name="session_ids" readonly="1">
                                <list limit="20">
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="vehicle_id"/>
                                    <field name="initial_soc" widget="progressbar"/>
                                    <field name="final_soc" widget="progressbar"/>
                                    <field name="kwh_dispensed"/>
                                    <field name="total_cost" widget="monetary"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Dispensador Físico: Kanban -->
    <record id="view_transit_charger_kanban" model="ir.ui.view">
        <field name="name">transit.charger.kanban</field>
        <field name="model">transit.charger</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <field name="name"/>
                <field name="status"/>
                <field name="ocpp_id"/>
                <field name="max_nominal_power_kw"/>
                <field name="current_output_kw"/>
                <field name="current_vehicle_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3">
                            <div class="d-flex justify-content-between mb-2">
                                <strong class="fs-6"><t t-esc="record.name.value"/></strong>
                                <span t-attf-class="badge #{record.status.raw_value == 'available' ? 'text-bg-success' : record.status.raw_value == 'charging' ? 'text-bg-warning' : 'text-bg-danger'}">
                                    <t t-esc="record.status.value"/>
                                </span>
                            </div>
                            <div class="text-muted small mb-1">
                                OCPP ID: <strong><t t-esc="record.ocpp_id.value"/></strong>
                            </div>
                            <div class="small mb-1">
                                Potencia: <strong><t t-esc="record.current_output_kw.value"/> / <t t-esc="record.max_nominal_power_kw.value"/> kW</strong>
                            </div>
                            <div t-if="record.current_vehicle_id.raw_value" class="mt-2 text-primary fw-bold small">
                                🔌 Bus: <t t-esc="record.current_vehicle_id.value"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acciones de Ventana -->
    <record id="action_transit_charging_station" model="ir.actions.act_window">
        <field name="name">Patios y Estaciones de Recarga (EV)</field>
        <field name="res_model">transit.charging.station</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_transit_charger" model="ir.actions.act_window">
        <field name="name">Dispensadores de Carga en Vivo</field>
        <field name="res_model">transit.charger</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
