<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista de Despachos (Odoo 18: list) -->
    <record id="view_transit_dispatch_tree" model="ir.ui.view">
        <field name="name">transit.dispatch.list</field>
        <field name="model">transit.dispatch</field>
        <field name="arch" type="xml">
            <list string="Despachos Diarios"
                  decoration-danger="semaphore_color == 'red' or speed_alert or deviation_alert"
                  decoration-warning="semaphore_color == 'yellow'"
                  decoration-success="semaphore_color == 'green'"
                  decoration-info="semaphore_color == 'blue'">
                <field name="name"/>
                <field name="date"/>
                <field name="service_id"/>
                <field name="route_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="tipo_dia" widget="badge"/>
                <field name="scheduled_departure"/>
                <field name="actual_departure"/>
                <field name="departure_delay_minutes"/>
                <field name="semaphore_color" widget="badge"
                       decoration-success="semaphore_color == 'green'"
                       decoration-warning="semaphore_color == 'yellow'"
                       decoration-danger="semaphore_color == 'red'"
                       decoration-info="semaphore_color == 'blue'"
                       string="Semáforo GPS"/>
                <field name="compliance_status" widget="badge"
                       decoration-success="compliance_status == 'on_time'"
                       decoration-warning="compliance_status in ('early', 'incomplete')"
                       decoration-danger="compliance_status in ('delayed', 'unperformed')"
                       decoration-info="compliance_status == 'reinforcement'"/>
                <field name="is_reserve_substituted" widget="boolean" optional="show" string="Reserva"/>
                <field name="battery_soc_departure" optional="hide" string="Bat. Salida %"/>
                <field name="battery_soc_arrival" optional="hide" string="Bat. Llegada %"/>
                <field name="layover_type" optional="hide" string="Parada Técnica"/>
                <field name="layover_duration_minutes" optional="hide" string="Min. Parada"/>
                <field name="layover_warning" widget="badge" decoration-danger="layover_warning" invisible="not layover_warning" optional="show" string="Alerta Parada"/>
                <field name="is_reinforcement" widget="badge" decoration-info="is_reinforcement" optional="hide"/>
                <field name="franja_horaria" optional="hide"/>
                <field name="is_recognized_icf" widget="boolean" optional="hide"/>
                <field name="current_geofence_status" optional="show"/>
                <field name="last_speed_kmh" optional="show"/>
                <field name="speed_alert" widget="badge" decoration-danger="speed_alert" invisible="not speed_alert"/>
                <field name="deviation_alert" widget="badge" decoration-danger="deviation_alert" invisible="not deviation_alert"/>
                <field name="total_passengers"/>
                <field name="km_traveled"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('dispatched', 'in_transit')"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'canceled'"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban Operativa en Vivo -->
    <record id="view_transit_dispatch_kanban" model="ir.ui.view">
        <field name="name">transit.dispatch.kanban</field>
        <field name="model">transit.dispatch</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="route_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="scheduled_departure"/>
                <field name="departure_delay_minutes"/>
                <field name="compliance_status"/>
                <field name="semaphore_color"/>
                <field name="is_reserve_substituted"/>
                <field name="layover_warning"/>
                <field name="current_geofence_status"/>
                <field name="last_speed_kmh"/>
                <field name="speed_alert"/>
                <field name="deviation_alert"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-2">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title font-weight-bold">
                                    <field name="name"/>
                                </strong>
                                <span class="text-muted d-block">
                                    <field name="route_id"/>
                                </span>
                            </div>
                            <div>
                                <span class="badge me-1" t-attf-class="#{record.semaphore_color.raw_value == 'green' ? 'text-bg-success' : record.semaphore_color.raw_value == 'yellow' ? 'text-bg-warning' : record.semaphore_color.raw_value == 'red' ? 'text-bg-danger' : record.semaphore_color.raw_value == 'blue' ? 'text-bg-info' : 'text-bg-secondary'}">
                                    <t t-if="record.semaphore_color.raw_value == 'green'">🟢 En Horario</t>
                                    <t t-elif="record.semaphore_color.raw_value == 'yellow'">🟡 Retraso</t>
                                    <t t-elif="record.semaphore_color.raw_value == 'red'">🔴 Cancelado</t>
                                    <t t-elif="record.semaphore_color.raw_value == 'blue'">🔵 Reserva</t>
                                    <t t-else="">⚪ Programado</t>
                                </span>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><i class="fa fa-bus text-primary me-1"></i> <field name="vehicle_id"/></div>
                            <div><i class="fa fa-user text-secondary me-1"></i> <field name="driver_id"/></div>
                            <div><i class="fa fa-clock-o text-muted me-1"></i> Salida: <field name="scheduled_departure"/></div>
                            <div t-if="record.is_reserve_substituted.raw_value" class="text-info fw-bold">
                                <i class="fa fa-retweet me-1"></i> Bus de Reserva Técnica
                            </div>
                            <div t-if="record.layover_warning.raw_value" class="text-warning fw-bold">
                                <i class="fa fa-hourglass-end me-1"></i> ¡Parada Insuficiente!
                            </div>
                            <div t-if="record.current_geofence_status.raw_value">
                                <i class="fa fa-map-marker text-success me-1"></i> <field name="current_geofence_status"/>
                            </div>
                            <div t-if="record.departure_delay_minutes.raw_value">
                                <i class="fa fa-tachometer text-info me-1"></i> Desvío: <strong><field name="departure_delay_minutes"/> min</strong>
                            </div>
                            <div t-if="record.speed_alert.raw_value" class="text-danger font-weight-bold mt-1">
                                <i class="fa fa-warning me-1"></i> ¡Exceso Velocidad! (<field name="last_speed_kmh"/> km/h)
                            </div>
                            <div t-if="record.deviation_alert.raw_value" class="text-danger font-weight-bold mt-1">
                                <i class="fa fa-exclamation-triangle me-1"></i> ¡Desvío de Itinerario!
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Formulario de Despacho -->
    <record id="view_transit_dispatch_form" model="ir.ui.view">
        <field name="name">transit.dispatch.form</field>
        <field name="model">transit.dispatch</field>
        <field name="arch" type="xml">
            <form string="Despacho Diario de Bus">
                <header>
                    <button name="action_inspect" string="Aprobar Inspección Previa" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="populate_checkpoints_from_route" string="Cargar Geocercas" type="object"
                            class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_dispatch" string="Marcar Salida en Cabecera" type="object"
                            class="oe_highlight" invisible="state not in ('draft', 'inspected')"/>
                    <button name="action_transit" string="Marcar En Ruta" type="object"
                            class="btn-primary" invisible="state != 'dispatched'"/>
                    <button name="action_complete" string="Finalizar Viaje y Guardar Km" type="object"
                            class="oe_highlight" invisible="state not in ('dispatched', 'in_transit')"/>
                    <button name="action_mark_incomplete" string="⚠️ Marcar Incompleto (~80%)" type="object"
                            class="btn-warning" invisible="state not in ('dispatched', 'in_transit')"/>
                    <button name="action_assign_reserve_bus" string="🔁 Sustituir por Bus de Reserva" type="object"
                            class="btn-info" invisible="state in ('completed', 'canceled')"/>
                    <button name="action_cancel" string="Cancelar Despacho" type="object"
                            invisible="state in ('completed', 'canceled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,inspected,dispatched,in_transit,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Número de Despacho"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <!-- Banners Informativos de Reserva y Alerta de Parada -->
                    <div class="alert alert-warning mb-2" role="alert" invisible="not layover_warning">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <strong>Alerta de Tiempo en Parada:</strong> El tiempo asignado en cabecera/parada es insuficiente para la actividad planificada (<field name="layover_type" readonly="1"/>). Riesgo de demora en cadena.
                    </div>
                    <div class="alert alert-info mb-2" role="alert" invisible="not is_reserve_substituted">
                        <i class="fa fa-info-circle me-2"/>
                        <strong>Cobertura con Bus de Reserva Técnica:</strong> Este despacho está cubierto por la unidad de reserva <field name="vehicle_id" readonly="1" class="fw-bold"/> en sustitución del titular <field name="substituted_vehicle_id" readonly="1" class="fw-bold"/>.
                    </div>

                    <group>
                        <group string="Programación del Viaje">
                            <field name="service_id"/>
                            <field name="route_id"/>
                            <field name="date"/>
                            <field name="tipo_dia" widget="badge"/>
                            <field name="timetable_id" invisible="is_reinforcement"/>
                            <field name="bus_schedule_id" invisible="not bus_schedule_id"/>
                            <field name="bus_schedule_line_id" invisible="not bus_schedule_id"/>
                            <field name="semaphore_color" widget="badge"
                                   decoration-success="semaphore_color == 'green'"
                                   decoration-warning="semaphore_color == 'yellow'"
                                   decoration-danger="semaphore_color == 'red'"
                                   decoration-info="semaphore_color == 'blue'"/>
                            <field name="is_reserve_substituted" invisible="not is_reserve_substituted"/>
                            <field name="substituted_vehicle_id" invisible="not is_reserve_substituted"/>
                            <field name="is_reinforcement" widget="boolean_toggle"/>
                            <field name="is_incomplete" widget="boolean_toggle"/>
                            <field name="scheduled_departure"/>
                            <field name="scheduled_arrival"/>
                        </group>
                        <group string="Asignación y Telemetría">
                            <field name="concessionaire_id"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="actual_departure"/>
                            <field name="actual_arrival"/>
                            <field name="departure_delay_minutes"/>
                            <field name="compliance_status" widget="badge"
                                   decoration-success="compliance_status == 'on_time'"
                                   decoration-warning="compliance_status in ('early', 'incomplete')"
                                   decoration-danger="compliance_status in ('delayed', 'unperformed')"
                                   decoration-info="compliance_status == 'reinforcement'"/>
                            <field name="franja_horaria"/>
                            <field name="tipo_franja_icf"/>
                            <field name="is_recognized_icf" widget="boolean_toggle"/>
                            <field name="current_geofence_status"/>
                            <field name="last_speed_kmh"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Checklist Pre-operativo (Seguridad)">
                            <div class="alert alert-info" role="alert">
                                <strong>Control Preventivo de Salida:</strong> Todos los ítems deben estar verificados antes de aprobar la inspección y habilitar la salida del bus.
                            </div>
                            <group>
                                <group string="Inspección Mecánica y de Seguridad">
                                    <field name="check_tires"/>
                                    <field name="check_brakes"/>
                                    <field name="check_lights"/>
                                    <field name="check_fluids"/>
                                    <field name="check_validator"/>
                                </group>
                                <group string="Resultado de Inspección">
                                    <field name="inspection_passed" widget="boolean_toggle"/>
                                    <field name="inspection_notes" placeholder="Observaciones o novedades encontradas en la unidad..."/>
                                </group>
                            </group>
                        </page>

                        <page string="Puntos de Control / Paradas">
                            <field name="checkpoint_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="checkpoint_type"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="radius_meters"/>
                                    <field name="scheduled_time"/>
                                    <field name="actual_time"/>
                                    <field name="delay_minutes"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'crossed'"
                                           decoration-warning="status == 'pending'"
                                           decoration-danger="status == 'skipped'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Telemetría GPS en Vivo">
                            <group>
                                <group string="Posicionamiento y Velocidad">
                                    <field name="last_latitude"/>
                                    <field name="last_longitude"/>
                                    <field name="last_speed_kmh"/>
                                    <field name="last_gps_time"/>
                                </group>
                                <group string="Alertas y Estado Geocerca">
                                    <field name="current_geofence_status"/>
                                    <field name="speed_alert" widget="boolean_toggle"/>
                                    <field name="deviation_alert" widget="boolean_toggle"/>
                                    <field name="last_deviation_meters"/>
                                </group>
                            </group>
                        </page>

                        <page string="Control de Kilometraje">
                            <group>
                                <group>
                                    <field name="initial_odometer"/>
                                    <field name="final_odometer"/>
                                    <field name="km_traveled"/>
                                </group>
                            </group>
                        </page>

                        <page string="Sensórica APC e IPK (Auditoría Evasión)" name="apc_sensors">
                            <div class="alert alert-warning mb-2" role="alert" invisible="not evasion_alert">
                                <strong>⚠️ ALERTA DE EVASIÓN DETECTADA:</strong>
                                La discrepancia entre ascensos contados por cámaras 3D y pasajes validados supera el 10%.
                            </div>
                            <div class="alert alert-danger mb-2" role="alert" invisible="not structural_overload_alert">
                                <strong>🚨 ALERTA DE SOBRECARGA ESTRUCTURAL:</strong>
                                La carga en ejes excede el 95% del peso bruto máximo autorizado.
                            </div>
                            <group>
                                <group string="Conteo Automático de Pasajeros (Cámaras 3D)">
                                    <field name="apc_boardings"/>
                                    <field name="apc_alightings"/>
                                    <field name="apc_total_passengers" class="fw-bold"/>
                                    <field name="calculated_ipk" digits="[6, 3]" class="fs-5 text-primary fw-bold"/>
                                </group>
                                <group string="Auditoría de Evasión vs Billetaje">
                                    <field name="electronic_validations"/>
                                    <field name="evasion_gap_passengers"/>
                                    <field name="evasion_rate" widget="progressbar"/>
                                    <field name="evasion_alert" widget="badge" decoration-danger="evasion_alert"/>
                                </group>
                            </group>
                            <group string="Sensores de Carga en Ejes (J1939 CAN-bus)">
                                <group>
                                    <field name="axle_weight_kg"/>
                                    <field name="max_gross_weight_kg"/>
                                </group>
                                <group>
                                    <field name="passenger_load_percentage" widget="progressbar"/>
                                    <field name="structural_overload_alert" widget="badge" decoration-danger="structural_overload_alert"/>
                                </group>
                            </group>
                        </page>

                        <page string="Pasajes y Recaudación">
                            <group>
                                <group>
                                    <field name="total_passengers"/>
                                    <field name="total_revenue"/>
                                </group>
                            </group>
                            <field name="ticket_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="passenger_name"/>
                                    <field name="passenger_doc"/>
                                    <field name="seat_number"/>
                                    <field name="price"/>
                                    <field name="state" widget="badge"/>
                                    <field name="invoice_id"/>
                                </list>
                            </field>
                        </page>

                        <page string="Parada Técnica y Batería EV (Planilla)" name="layover_ev">
                            <group>
                                <group string="Tiempo de Parada Técnica / Mantenimiento / Regulación">
                                    <field name="layover_type"/>
                                    <field name="layover_duration_minutes"/>
                                    <field name="layover_warning" widget="badge" decoration-danger="layover_warning"/>
                                </group>
                                <group string="Monitoreo de Batería Eléctrica (SoC)">
                                    <field name="battery_soc_departure" widget="progressbar"/>
                                    <field name="battery_soc_arrival" widget="progressbar"/>
                                    <field name="battery_consumption_pct"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista Calendario de Despachos -->
    <record id="view_transit_dispatch_calendar" model="ir.ui.view">
        <field name="name">transit.dispatch.calendar</field>
        <field name="model">transit.dispatch</field>
        <field name="arch" type="xml">
            <calendar string="Despachos" date_start="scheduled_departure" date_stop="scheduled_arrival" color="vehicle_id" mode="month">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="route_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Vista Pivot de Puntualidad y Despachos -->
    <record id="view_transit_dispatch_pivot" model="ir.ui.view">
        <field name="name">transit.dispatch.pivot</field>
        <field name="model">transit.dispatch</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Despachos y Puntualidad" sample="1">
                <field name="route_id" type="row"/>
                <field name="compliance_status" type="col"/>
                <field name="departure_delay_minutes" type="measure"/>
                <field name="km_traveled" type="measure"/>
                <field name="total_passengers" type="measure"/>
                <field name="total_revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vista Gráfico de Cumplimiento -->
    <record id="view_transit_dispatch_graph" model="ir.ui.view">
        <field name="name">transit.dispatch.graph</field>
        <field name="model">transit.dispatch</field>
        <field name="arch" type="xml">
            <graph string="Puntualidad por Ruta y Cumplimiento" type="bar" sample="1">
                <field name="route_id"/>
                <field name="compliance_status"/>
            </graph>
        </field>
    </record>

    <!-- Vista Búsqueda de Despachos -->
    <record id="view_transit_dispatch_search" model="ir.ui.view">
        <field name="name">transit.dispatch.search</field>
        <field name="model">transit.dispatch</field>
        <field name="arch" type="xml">
            <search string="Buscar Despachos">
                <field name="name"/>
                <field name="service_id"/>
                <field name="route_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter string="Hoy" name="today" domain="[('date', '=', context_today())]"/>
                <filter string="Próximos Días" name="future" domain="[('date', '&gt;', context_today())]"/>
                <separator/>
                <filter string="Regulares (En Horario)" name="on_time" domain="[('compliance_status', '=', 'on_time')]"/>
                <filter string="Irregulares (Atrasados)" name="delayed" domain="[('compliance_status', '=', 'delayed')]"/>
                <filter string="Irregulares (Adelantados)" name="early" domain="[('compliance_status', '=', 'early')]"/>
                <filter string="Salidas de Refuerzo" name="reinforcement" domain="[('is_reinforcement', '=', True)]"/>
                <filter string="Viajes Incompletos (~80%)" name="incomplete" domain="[('is_incomplete', '=', True)]"/>
                <filter string="No Realizados / Faltantes" name="unperformed" domain="[('compliance_status', '=', 'unperformed')]"/>
                <separator/>
                <filter string="Días Laborales (L-V)" name="day_laboral" domain="[('tipo_dia', '=', '5')]"/>
                <filter string="Sábados" name="day_sabado" domain="[('tipo_dia', '=', '6')]"/>
                <filter string="Domingos y Feriados" name="day_dom_fer" domain="[('tipo_dia', '=', '7')]"/>
                <separator/>
                <filter string="Hora Pico" name="franja_pico" domain="[('tipo_franja_icf', '=', 'pico')]"/>
                <filter string="Sin Unidad Asignada" name="unassigned" domain="[('vehicle_id', '=', False)]"/>
                <filter string="En Tránsito" name="in_transit" domain="[('state', '=', 'in_transit')]"/>
                <separator/>
                <filter string="🟢 Semáforo: En Horario / Correcto" name="sem_green" domain="[('semaphore_color', '=', 'green')]"/>
                <filter string="🟡 Semáforo: Con Retraso / Alerta" name="sem_yellow" domain="[('semaphore_color', '=', 'yellow')]"/>
                <filter string="🔴 Semáforo: Cancelado / No Realizado" name="sem_red" domain="[('semaphore_color', '=', 'red')]"/>
                <filter string="🔵 Semáforo: Cubierto por Reserva" name="sem_blue" domain="[('semaphore_color', '=', 'blue')]"/>
                <separator/>
                <filter string="🔁 Despachos Cubiertos por Reserva" name="reserve_subst" domain="[('is_reserve_substituted', '=', True)]"/>
                <filter string="⚠️ Alerta Tiempo de Parada Insuficiente" name="layover_warn" domain="[('layover_warning', '=', True)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Servicio Especial" name="group_service" context="{'group_by': 'service_id'}"/>
                    <filter string="Ruta / Ramal" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Semáforo GPS" name="group_semaphore" context="{'group_by': 'semaphore_color'}"/>
                    <filter string="Régimen / Tipo de Día" name="group_tipo_dia" context="{'group_by': 'tipo_dia'}"/>
                    <filter string="Puntualidad / Regularidad" name="group_compliance" context="{'group_by': 'compliance_status'}"/>
                    <filter string="Tipo de Parada Técnica" name="group_layover" context="{'group_by': 'layover_type'}"/>
                    <filter string="Franja Horaria" name="group_franja" context="{'group_by': 'franja_horaria'}"/>
                    <filter string="Bus / Unidad" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Chofer" name="group_driver" context="{'group_by': 'driver_id'}"/>
                    <filter string="Estado Operación" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fecha Operativa" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana para Despachos -->
    <record id="action_transit_dispatch" model="ir.actions.act_window">
        <field name="name">Despachos Diarios</field>
        <field name="res_model">transit.dispatch</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva Orden de Despacho Diario
            </p>
            <p>
                Asigna una unidad y chofer a un horario programado, realiza la inspección de seguridad previa y monitorea el cumplimiento en tiempo real.
            </p>
        </field>
    </record>
</odoo>
